# Kimiko AI Companion – Environment Variables
# Copy this file to .env and fill in your actual keys.

# Gemini API key (required) – https://aistudio.google.com/apikey
export GEMINI_API_KEY='your-gemini-api-key-here'

# Groq API key (required for voice input) – https://console.groq.com/keys
export GROQ_API_KEY='your-groq-api-key-here'

# Optional: Override default model
# export GEMINI_MODEL='gemini-2.5-flash-lite'

# Optional: LM Studio embedding server
# export LM_STUDIO_URL='http://127.0.0.1:1234/v1'
# export LM_STUDIO_HOST='127.0.0.1'
# export LM_STUDIO_PORT='1234'

# Optional: GPT-SoVITS TTS server
# export SOVITS_URL='http://127.0.0.1:9880'
# export SOVITS_DIR='C:\GPT-SoVITS-v2pro-20250604\GPT-SoVITS-v2pro-20250604'
